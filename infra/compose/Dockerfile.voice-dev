# Reuse the published dependencies for a quick, local voice test build.
ARG BASE_IMAGE=ghcr.io/elie222/rakazo/app:edge
FROM ${BASE_IMAGE}
USER root
WORKDIR /app
COPY --chmod=755 . .
ENV NODE_ENV=development CI=true
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter @rakazo/db generate
RUN RAKAZO_ALLOW_DEV_SECRETS=1 pnpm --filter @rakazo/web build
RUN install -d -m 750 -o node -g node /app/apps/web/node_modules/.vite-temp
ENV NODE_ENV=production
USER node
